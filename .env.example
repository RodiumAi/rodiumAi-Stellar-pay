# Copy to `.env` for local development. Never commit `.env`.
# Staging/production values come from AWS Secrets Manager, not from files (context §12.4).
# Every value below is a placeholder.

# ── Service ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Stellar (context §13.5) ──────────────────────────────────────────────────
# Prefixed RP_ because stellar-cli reads this .env and owns the STELLAR_* names.
RP_STELLAR_NETWORK=testnet
# Optional on testnet (defaults to SDF's public endpoints). REQUIRED on mainnet:
# SDF runs no public mainnet RPC, so use a provider URL.
RP_STELLAR_RPC_URL=
RP_STELLAR_HORIZON_URL=
# Merchant account that receives USDC (G...).
MERCHANT_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Deployed subscription contract (C...). Set after Sprint 4 deploys it.
SUBSCRIPTION_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MAX_FEE_STROOPS=100000
# Soroban calls (subscribe, charge, TTL) also pay a resource fee; default 2 XLM.
MAX_SOROBAN_FEE_STROOPS=20000000

# ── Exposure caps (plan §6) ──────────────────────────────────────────────────
MAX_PAYMENT_USDC=500
MAX_SUBSCRIPTION_PRICE_USDC=100
SUBSCRIPTION_APPROVE_PERIODS=3

# ── FX: ExchangeRate-API (context §6 Quote) ──────────────────────────────────
FX_SUPPORTED_FIAT=USD,GHS
# 26 h fits the free plan's daily updates; use 3900 (65 min) on the Pro plan.
FX_MAX_RATE_AGE_SECONDS=93600
EXCHANGERATE_API_KEY=

# ── Supabase Postgres (context §7.3, §7.5) ───────────────────────────────────
# One connection string per role. From the Supabase dashboard → Connect.
# Pooler usernames are `<role>.<project_ref>`; port 6543 = transaction mode,
# 5432 = session mode. Always sslmode=verify-full in staging/production.
#
# Local: `pnpm db:start && pnpm db:setup` creates the `rodium_pay_dev` database with the
# RP_*_PASSWORD values below and fills these six lines with local URLs automatically.
#
# API and worker jobs: transaction mode.
DATABASE_URL_API=postgresql://rp_api.<project_ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
DATABASE_URL_WORKER=postgresql://rp_worker.<project_ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Ingester leader lock: session mode (advisory locks are session-scoped).
DATABASE_URL_WORKER_SESSION=postgresql://rp_worker.<project_ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Read-only support access.
DATABASE_URL_READONLY=postgresql://rp_readonly.<project_ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Migrations (rp_owner): direct or session mode, used by CI/CD only.
DATABASE_URL_OWNER=postgresql://rp_owner.<project_ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Role bootstrap (`infra/supabase/bootstrap-roles.sql`) runs as the Supabase `postgres` role.
DATABASE_URL_ADMIN=postgresql://postgres.<project_ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Passwords for bootstrap-roles.sql: 32+ random bytes each, e.g. `openssl rand -hex 32`.
RP_OWNER_PASSWORD=
RP_API_PASSWORD=
RP_WORKER_PASSWORD=
RP_READONLY_PASSWORD=

# ── Upstash Redis (context §8) ───────────────────────────────────────────────
# From the Upstash console → your database → REST API section.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── API (apps/api, context §9) ───────────────────────────────────────────────
PORT=8080
# Public origin of the hosted checkout; checkout_url = CHECKOUT_BASE_URL/c/<token>.
CHECKOUT_BASE_URL=http://localhost:8081
# Exact origins (scheme://host[:port]) allowed for return_url, comma-separated.
RETURN_URL_ORIGINS=http://localhost:3000
PAYMENT_TTL_SECONDS=1200
# Plans the main app may subscribe to; contractPlanId must match set_plan on the contract.
SUBSCRIPTION_PLANS=[{"code":"pro_monthly","contractPlanId":1,"price":"9.99","intervalSeconds":2592000}]

# ── Worker (apps/worker, context §15) ───────────────────────────────────────
WORKER_PORT=9090
# Main app endpoint that receives signed webhooks (https in production).
WEBHOOK_URL=http://localhost:3000/webhooks/crypto
# horizon (default) | rpc. rpc needs INGEST_START_LEDGER for the very first run.
INGEST_SOURCE=horizon
# Optional: first ledger to scan when no cursor exists yet (default: "now").
INGEST_START_LEDGER=

# ── Subscriptions: signer + keeper (context §13.1, §14.5) ────────────────────
# Worker → signer over mTLS. `scripts/dev-mtls.sh` creates dev certificates in .mtls/.
SIGNER_URL=https://localhost:9443
WORKER_TLS_KEY=
WORKER_TLS_CERT=
WORKER_TLS_CA=
# Keeper public key (fee payer, only caller allowed to `charge`).
KEEPER_ADDRESS=
KEEPER_MIN_BALANCE_XLM=50
# Signer process only — in production this lives in the signer's own secret, never here.
SIGNER_PORT=9443
SIGNER_TLS_KEY=
SIGNER_TLS_CERT=
SIGNER_TLS_CA=
KEEPER_SECRET=

# ── Keys and secrets (context §12.4) ─────────────────────────────────────────
# Any secret can come from a mounted file instead: FOO_FILE=/path sets FOO from the
# file (AWS Secrets Manager via the CSI driver). Setting FOO and FOO_FILE is an error.
# Comma-separated `key_id:base64url_secret` pairs; two may be active during rotation.
API_HMAC_KEYS=
# Webhook Ed25519 private key (PEM, PKCS#8) and its key id.
WEBHOOK_SIGNING_KEY_ID=whk_2026_10
WEBHOOK_SIGNING_KEY_PEM=
# Checkout tokens are HMAC(CHECKOUT_TOKEN_KEY, id): 32+ random bytes, base64url.
CHECKOUT_TOKEN_KEY=
# Field-encryption data keys: `hex_id:base64url_wrapped_key`, wrapped by the KMS.
# `pnpm env:data-key` creates one with the local dev KMS.
FIELD_DATA_KEYS=
FIELD_DATA_KEY_CURRENT=
# Blind-index key: 32+ random bytes, base64url.
BLIND_INDEX_KEY=
# Staging/production: AWS KMS key (ARN, alias/… or key id) wrapping the data keys.
# Region and credentials come from the AWS chain (IAM role). New data key:
#   AWS_KMS_KEY_ID=… node apps/api/scripts/aws-data-key.mjs
AWS_KMS_KEY_ID=
# Local development only: master key for the dev KMS (32 bytes, base64url).
# Ignored when AWS_KMS_KEY_ID is set; refused in production.
LOCAL_DEV_KMS_MASTER_KEY=
