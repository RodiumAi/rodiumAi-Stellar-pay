{
  "name": "@rp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./audit-log": {
      "@rp/source": "./src/audit-log.ts",
      "types": "./dist/audit-log.d.ts",
      "default": "./dist/audit-log.js"
    },
    "./connection": {
      "@rp/source": "./src/connection.ts",
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    },
    "./cursors": {
      "@rp/source": "./src/cursors.ts",
      "types": "./dist/cursors.d.ts",
      "default": "./dist/cursors.js"
    },
    "./leader-lock": {
      "@rp/source": "./src/leader-lock.ts",
      "types": "./dist/leader-lock.d.ts",
      "default": "./dist/leader-lock.js"
    },
    "./migrate": {
      "@rp/source": "./src/migrate.ts",
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./outbox": {
      "@rp/source": "./src/outbox.ts",
      "types": "./dist/outbox.d.ts",
      "default": "./dist/outbox.js"
    },
    "./payment-receipts": {
      "@rp/source": "./src/payment-receipts.ts",
      "types": "./dist/payment-receipts.d.ts",
      "default": "./dist/payment-receipts.js"
