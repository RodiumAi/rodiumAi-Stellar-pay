    "./payments": {
      "@rp/source": "./src/payments.ts",
      "types": "./dist/payments.d.ts",
      "default": "./dist/payments.js"
    },
    "./receipts": {
      "@rp/source": "./src/receipts.ts",
      "types": "./dist/receipts.d.ts",
      "default": "./dist/receipts.js"
    },
    "./schema": {
      "@rp/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./subscriptions": {
      "@rp/source": "./src/subscriptions.ts",
      "types": "./dist/subscriptions.d.ts",
      "default": "./dist/subscriptions.js"
    }
  },
  "dependencies": {
    "@rp/core": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
