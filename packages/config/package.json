{
  "name": "@rp/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-config": {
      "@rp/source": "./src/app-config.ts",
      "types": "./dist/app-config.d.ts",
      "default": "./dist/app-config.js"
    },
    "./secret-files": {
      "@rp/source": "./src/secret-files.ts",
      "types": "./dist/secret-files.d.ts",
      "default": "./dist/secret-files.js"
    },
    "./network": {
      "@rp/source": "./src/network.ts",
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    }
  },
  "dependencies": {
    "@rp/core": "workspace:*",
    "zod": "4.6.7"
  }
}
