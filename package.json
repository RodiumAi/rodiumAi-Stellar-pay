{
  "name": "rodiumai-stellar-pay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --build && tsc -p tsconfig.tools.json && tsc -p packages/db/test && tsc -p packages/stellar/test && tsc -p apps/api/test && tsc -p apps/worker/test && tsc -p apps/admin/test",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "build:all": "pnpm typecheck && pnpm checkout:build",
    "e2e:testnet:subscriptions": "node apps/api/scripts/e2e-testnet-subscriptions.mjs",
    "e2e:testnet": "node apps/api/scripts/e2e-testnet.mjs",
    "e2e:release": "./scripts/e2e-release.sh",
    "e2e:remote": "node apps/api/scripts/e2e-remote.mjs",
    "load:sanity": "node apps/api/scripts/load-sanity.mjs",
    "checkout:build": "pnpm --filter @rp/checkout build && node scripts/check-bundle.mjs && pnpm --filter @rp/docs build",
    "test:redis": "vitest run --project redis-int",
    "redis:start": "./scripts/redis-local.sh start",
    "redis:stop": "./scripts/redis-local.sh stop",
    "test:e2e": "vitest run --project e2e",
    "test:stellar": "vitest run --project stellar-int",
    "stellar:start": "./scripts/stellar-quickstart.sh start",
    "stellar:stop": "./scripts/stellar-quickstart.sh stop",
    "db:start": "supabase --workdir infra start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase --workdir infra stop",
    "env:api": "node apps/api/scripts/fill-env.mjs",
    "api:call": "node --env-file=.env apps/api/scripts/call.mjs",
    "signer:start": "node --permission --allow-fs-read=. --env-file=.env apps/signer/dist/main.js",
    "worker:start": "node --env-file=.env apps/worker/dist/main.js",
    "api:start": "pnpm typecheck && node --env-file=.env apps/api/dist/main.js",
    "db:setup": "node --disable-warning=ExperimentalWarning packages/db/scripts/setup-local.mjs",
    "db:setup:supabase": "node --disable-warning=ExperimentalWarning packages/db/scripts/setup-supabase.mjs",
    "test:coverage": "vitest run --project unit --coverage",
    "secrets:scan": "gitleaks git --redact --no-banner",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm audit --audit-level high && pnpm secrets:scan && ./scripts/verify-db.sh && ./scripts/verify-contracts.sh"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-security": "4.2.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
